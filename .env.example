# Optional: watching the bundled tournament and running built-in bots need no key.
OPENROUTER_API_KEY=
RAWMODELS_API_KEY=
# Local server defaults. Binding to loopback keeps paid API actions local.
HOST=127.0.0.1
PORT=3100
ARENA_DATA_DIR=./data
# Request attempts, including retries, per match launched from the editor.
ARENA_MAX_REQUESTS=3000
# Set an exact external origin only when using an authenticated reverse proxy.
# ARENA_ORIGIN=https://arena.example.com
